# Separate repositories (manuscript, annotation tool)
sfac_persona_paper/
sfac_persona_anno/

# Human audit: answer key, access codes and raw ratings stay local; the registered and exploratory
# result tables (aggregates only) are tracked once the audit closed (2026-10-09)
outputs/anno/
outputs/reports/anno_exploratory.md

# Cell-level differencing tables contain counts of suppressed cells
outputs/reports/era_sdc_differencing*.csv

# Report narratives (Markdown written by the scripts); the paper reads only the CSV/JSON reports
outputs/reports/*.md

# Microdata preparation: raw records, person-level outputs and generated reports stay local
preprocessing/data
preprocessing/reports/
paper/tables/

# Cell-by-draw rows of the respondent-resampled design pretest (gigabytes; regenerated by era_design_oos_pairs.py --resample-respondents)
outputs/reports/era_design_oos_pairs_cells_resp.csv
outputs/reports/era_design_oos_pairs_cells_tables_only.csv

# Saved OpenReview pages (contain author names; never commit)
reviewer/
submit/
submit_last/
